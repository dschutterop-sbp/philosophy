# Server and local service
PORT=8080
TIMEZONE=Europe/Amsterdam
OPENING_MIN_TEMPERATURE_C=18

# Signs approval tokens. Demo falls back to an openly labelled, insecure key;
# live mode refuses to run until this is set to a real secret.
APPROVAL_SIGNING_KEY=

# Everything below is only needed for live · agentic mode.
# Demo mode (static data, no external calls) runs with none of this set.

WEATHER_LATITUDE=
WEATHER_LONGITUDE=

# OpenAI: keep the real value only in .env
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Optionally use a different model family for semantic conformance to reduce
# correlated interpreter/executor/judge failures.
OPENAI_CONFORMANCE_MODEL=

# Live mode takes operational facts from deployment configuration, never the browser.
OPENING_HOURS=13:30-18:00
AVAILABLE_PRODUCTS=Aperol Spritz Sorbet,Limoncello Spritz Sorbet
# Number of recent materially similar posts, supplied by the publishing-history adapter
# (or temporarily by deployment configuration in this reference implementation).
RECENT_POSTS=0

# Reference-only identity adapter. Replace with authenticated identity in production.
DEMO_REVIEWER_ID=demo-publisher
DEMO_REVIEWER_ROLE=publisher

# Google Calendar OAuth 2.0. Use the least-privileged calendar.events.readonly scope.
GOOGLE_CALENDAR_ID=primary
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
