# Server and local service
PORT=8080
TIMEZONE=Europe/Amsterdam
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
OPENING_MIN_TEMPERATURE_C=18

# OpenAI: keep the real value only in .env
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Google Calendar OAuth 2.0. Use the least-privileged calendar.events.readonly scope.
GOOGLE_CALENDAR_ID=primary
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
