# Server and local service
PORT=8080
TIMEZONE=Europe/Amsterdam
OPENING_MIN_TEMPERATURE_C=18

# Everything below is only needed for live · agentic mode.
# Demo mode (static data, no external calls) runs with none of this set.

WEATHER_LATITUDE=
WEATHER_LONGITUDE=

# OpenAI: keep the real value only in .env
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Google Calendar OAuth 2.0. Use the least-privileged calendar.events.readonly scope.
GOOGLE_CALENDAR_ID=primary
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
